# Salin ke .env lalu GANTI semua nilai rahasia.
POSTGRES_PASSWORD=ganti-kata-sandi-postgres
YSNA_JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
YSNA_PSEUDONYM_KEY=ganti-dengan-kunci-hmac-acak-dan-simpan-aman
YSNA_DATA_MODE=DEMO
# YSNA_ADMIN_PASSWORD=   # wajib bila YSNA_DATA_MODE=LIVE
# YSNA_DEMO_PASSWORD=    # opsional, kata sandi akun demo

# Kredensial API resmi (kosongkan bila tidak punya akses)
YSNA_YOUTUBE_API_KEY=
YSNA_X_BEARER_TOKEN=
YSNA_TIKTOK_CLIENT_KEY=
YSNA_TIKTOK_CLIENT_SECRET=
